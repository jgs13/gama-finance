{
  "name": "gama-finance",
  "version": "1.0.0",
  "private": true,
  "description": "GAMA FINANCE - aplicativo financeiro web e Android",
  "scripts": {
    "android:prepare": "node scripts/prepare-android.mjs && esbuild native-notifications.js --bundle --format=esm --outfile=www/native-notifications.js",
    "android:add": "cap add android",
    "android:sync": "npm run android:prepare && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "npm run android:prepare && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "esbuild": "^0.25.0"
  }
}
